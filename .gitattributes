# Normalize line endings: store all text files with LF in the repository, regardless of the
# contributor's OS or core.autocrlf setting. Git auto-detects text vs binary; detected binary
# files (images, fonts, etc.) are left untouched. This prevents CRLF/mixed-ending churn.
* text=auto eol=lf

# Belt-and-suspenders: force LF for the source/config/doc file types this repo uses.
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.csv  text eol=lf
*.mmd  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf
