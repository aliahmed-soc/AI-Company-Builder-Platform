{
  "name": "ai-company-builder-platform",
  "version": "0.0.0",
  "private": true,
  "description": "AI Company Builder Platform — monorepo scaffold (ACBP-P0-011). No product functionality yet.",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "eslint .",
    "check:secrets": "node tools/check-secrets.mjs",
    "check:encoding": "node tools/check-encoding.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:reset-lists": "node tools/check-reset-lists.mjs",
    "check:conflict-targets": "node tools/check-conflict-targets.mjs",
    "check:approval-port": "node tools/check-approval-port.mjs",
    "check:stop-port": "node tools/check-stop-port.mjs",
    "check:usage-kind-predicate": "node tools/check-usage-kind-predicate.mjs",
    "check:migration-drain-loops": "node tools/check-migration-drain-loops.mjs",
    "check:trust-critical-index": "node tools/check-trust-critical-index.mjs",
    "test:boundaries": "vitest run tools/tests/check-boundaries.test.mjs tools/tests/check-reset-lists.test.mjs tools/tests/check-approval-port.test.mjs tools/tests/check-trust-critical-index.test.mjs tools/tests/check-secrets.test.mjs",
    "test:config": "vitest run packages/config",
    "test:observability": "vitest run packages/observability",
    "test:database": "vitest run packages/database",
    "db:migrate": "tsx packages/database/src/cli.ts migrate",
    "db:migrate:status": "tsx packages/database/src/cli.ts status",
    "db:migrate:down": "tsx packages/database/src/cli.ts down",
    "db:reset": "tsx packages/database/src/cli.ts reset",
    "db:check": "tsx packages/database/src/cli.ts check",
    "dev:web": "pnpm --filter @acbp/web dev",
    "dev:worker": "pnpm --filter @acbp/worker dev",
    "local:doctor": "node tools/local/doctor.mjs",
    "ci:preflight": "node tools/ci/preflight.mjs",
    "demo:slice-a": "tsx tools/demo/slice-a.mjs",
    "demo:slice-b": "tsx tools/demo/slice-b.mjs",
    "demo:slice-c": "tsx tools/demo/slice-c.mjs",
    "demo:slice-d": "tsx tools/demo/slice-d.mjs",
    "demo:slice-e": "tsx tools/demo/slice-e.mjs",
    "demo:slice-f": "tsx tools/demo/slice-f.mjs",
    "local:db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/local/db.ps1 -Action setup",
    "local:db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/local/db.ps1 -Action start",
    "local:db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/local/db.ps1 -Action stop",
    "local:db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/local/db.ps1 -Action status",
    "check:static": "pnpm run typecheck && pnpm run lint && pnpm run check:secrets && pnpm run check:encoding && pnpm run check:boundaries && pnpm run check:reset-lists && pnpm run check:conflict-targets && pnpm run check:approval-port && pnpm run check:stop-port && pnpm run check:usage-kind-predicate && pnpm run check:migration-drain-loops && pnpm run check:trust-critical-index && pnpm run test:boundaries",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run check:static && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "tsx": "^4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
