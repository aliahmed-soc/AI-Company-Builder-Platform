# ACBP-P0-015 — example environment. NAMES + FAKE PLACEHOLDERS ONLY — never real secrets.
# Copy to `.env` for local development. `.env` is gitignored; only `.env.example` is committed.
# Staging/production values come from Infisical (ADR-021), not from committed files.

# --- Application environment (drives validation; used by server, worker, and public config) ---
APP_ENV=development                       # one of: development | test | staging | production

# --- PUBLIC (client-safe; explicitly allowlisted in @acbp/config) ---
APP_PUBLIC_URL=http://localhost:3000      # must be https in production

# --- WEB SERVER (server-only) ---
PORT=3000                                 # integer 1..65535
APP_TELEMETRY_ENABLED=false               # boolean: true|false|1|0
REQUEST_TIMEOUT=30s                       # duration: e.g. 500ms, 30s, 5m

# --- WORKER (server-only) ---
WORKER_CONCURRENCY=2                       # integer 1..64

# --- BOOTSTRAP: Infisical machine identity (server-only; the ONLY secret in env, ADR-021 §8) ---
# Everything else (provider keys, DB creds, etc.) is fetched from Infisical at runtime — never here.
INFISICAL_SITE_URL=https://app.infisical.com
INFISICAL_ENVIRONMENT=development          # defaults to APP_ENV if omitted
INFISICAL_CLIENT_ID=example-client-id-placeholder
INFISICAL_CLIENT_SECRET=example-placeholder-not-a-real-secret

# --- LOCAL DEVELOPMENT (optional; ACBP-P0-021) ---------------------------------------------
# Names shown for discoverability with obviously-FAKE placeholders. Do NOT put real values here.
# For local Postgres, `pnpm local:db:setup` writes the REAL local URLs to a git-ignored `.env.local`
# (never committed). In staging/production these come from Infisical (ADR-021), not from any file.
# See docs/LOCAL-DEVELOPMENT.md.
# DATABASE_URL=postgresql://acbp_dev:local-dev-placeholder@127.0.0.1:5432/acbp_dev
# ACBP_TEST_DATABASE_URL=postgresql://acbp_dev:local-dev-placeholder@127.0.0.1:5432/acbp_test

# --- CLERK AUTHENTICATION (optional; ACBP-P1-001) ------------------------------------------
# From a Clerk DEVELOPMENT instance (dashboard). FAKE placeholders only; never commit real keys.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is client-safe (Next.js public convention → inlined in the
# browser bundle); CLERK_SECRET_KEY / CLERK_JWT_KEY are server-only. @clerk/nextjs reads these
# names automatically. In staging/production these come from Infisical (ADR-021), not any file.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_fake-placeholder-not-real
# CLERK_SECRET_KEY=sk_test_fake-placeholder-not-real
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# CLERK_JWT_KEY=
# Optional custom auth routes (defaults: /sign-in, /sign-up):
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
